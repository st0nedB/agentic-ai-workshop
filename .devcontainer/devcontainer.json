{
  "name": "Agentic AI Workshop",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "mkdir -p workspace/eingang workspace/ergebnisse && python3 01_dateichaos/material_bereitstellen.py && python3 03_sandboxing/prepare.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "marp-team.marp-vscode"
      ],
      "settings": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000
      }
    }
  },
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  }
}
