{
  "name": "Agentic AI Workshop",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "mkdir -p workspace/eingang workspace/ergebnisse && python3 01_dateichaos/material_bereitstellen.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000
      }
    }
  },
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  }
}
